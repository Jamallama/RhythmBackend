{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "None"
    }
  },
  "AllowedHosts": "*",
  "SessionApi": {
    "StorageProvider": "AzureBlob",
    "ContainerName": "rhythm-sessions",
    "LifetimeHours": 24,
    "CleanupIntervalMinutes": 15,
    "MaxRunsPerSession": 200,
    "QrLoggingRedactionConfirmed": false,
    "AllowedOrigins": ["https://seaweedbrainn.github.io"]
  }
}
