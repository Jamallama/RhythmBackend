{
  "type": "OBJECT",
  "properties": {
    "mode": { "type": "STRING", "enum": ["song_debrief", "session_debrief", "chat"] },
    "tier": { "type": "STRING", "enum": ["A", "B", "mixed"], "nullable": true },
    "coaching_focus": { "type": "STRING", "enum": ["judgement_quality", "combo_continuity", "recovery_after_miss", "density_or_difficulty", "consistency", "lane_execution", "timing_bias", "timing_spread", "calibration_check", "progression", "data_quality", "none"] },
    "speech": { "type": "STRING" },
    "phone_text": { "type": "ARRAY", "items": { "type": "STRING" } },
    "what_went_well": { "type": "STRING", "nullable": true },
    "observations": { "type": "ARRAY", "items": { "type": "OBJECT", "properties": { "label": { "type": "STRING" }, "value": { "type": "STRING" }, "interpretation": { "type": "STRING" } }, "required": ["label", "value", "interpretation"] } },
    "drill": { "type": "STRING", "nullable": true },
    "next_target": { "type": "STRING", "nullable": true },
    "focus_section": { "type": "OBJECT", "nullable": true, "properties": { "start_s": { "type": "INTEGER" }, "end_s": { "type": "INTEGER" }, "reason": { "type": "STRING" } }, "required": ["start_s", "end_s", "reason"] },
    "data_notes": { "type": "ARRAY", "items": { "type": "STRING" } },
    "confidence": { "type": "STRING", "enum": ["low", "medium", "high"] },
    "evidence_basis": { "type": "STRING", "enum": ["measured_run_data", "cross_run_pattern", "game_heuristic", "practice_convention", "mixed_evidence", "none"] }
  },
  "required": ["mode", "tier", "coaching_focus", "speech", "phone_text", "what_went_well", "observations", "drill", "next_target", "focus_section", "data_notes", "confidence", "evidence_basis"]
}
